<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ case_name }} | Forensia Report</title>
  <style>{% include "report.css.j2" %}</style>
</head>
<body>
  <main class="page">
    <article class="paper">
      {% include "partials/report_header.html.j2" %}
      <section class="content">
        {% if report_toc_html %}
          <nav class="toc-sidebar" aria-label="Table of contents">
            <p class="toc-title">Contents</p>
            {{ report_toc_html }}
          </nav>
        {% endif %}
        <div class="content-inner">
          <section class="report-body" aria-label="Investigation report">
            {{ report_body_html }}
          </section>
          {% include "partials/key_findings.html.j2" %}
        </div>
      </section>
    </article>
  </main>
</body>
</html>
