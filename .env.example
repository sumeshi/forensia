# Copy to .env for local development.
# Keep .env private; do not commit real endpoints, API keys, or case-specific values.

# forensia is designed for local/offline OpenAI-compatible LLM servers.
# Example only: forensia accepts any OpenAI-compatible model and never branches on this ID.
# This profile is tested with Ornith-1.5-9B served through llama.cpp.
# Use the server root without /v1; forensia appends /v1/chat/completions.
LLM_BASE_URL="http://127.0.0.1:8080"
# LLM_API_KEY="replace-with-provider-key"
LLM_MODEL="Ornith-1.5-9B"

# Capacity for this example model/server; replace it with the selected provider's limits.
LLM_CONTEXT_WINDOW_TOKENS=131072
LLM_MAX_TOKENS=16384
# LLM_TEMPERATURE=0.0

# Prompt assembly.
FORENSIA_PROMPT_BUDGET_TOKENS=98304
# FORENSIA_SYSTEM_PROMPT_BUDGET_CHARS=196608

# Optional investigation/report limits. Zero selects the conservative default.
# LLM_REASONING_RESERVE_TOKENS=0

# Per-run execution limits. LLM_MAX_CALLS=0 disables only the call-count cap.
# FORENSIA_MAX_ITERATIONS=20
# FORENSIA_MAX_QUERIES_PER_HYPOTHESIS=5
# LLM_MAX_CALLS=200
# FORENSIA_REPORT_MAX_QUERIES_PER_SECTION=3
# FORENSIA_REPORT_MARKDOWN_MAX_ROWS=200

# Output and report behavior.
# FORENSIA_OUTPUT_LANGUAGE=ja

# LLM outage recovery.
# LLM_OUTAGE_WALL_CLOCK_BUDGET_S=28800
# LLM_OUTAGE_PROBE_INTERVAL_S=60
