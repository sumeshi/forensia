# Copy to .env for local development.
# Keep .env private; do not commit real endpoints, API keys, or case-specific values.

# forensia is designed for local/offline OpenAI-compatible LLM servers.
LLM_BASE_URL="http://127.0.0.1:1234"
LLM_MODEL="google/gemma-4-e4b"
# LLM_API_KEY=""

# Optional runtime overrides. Leave these unset unless the default is unsuitable.
# LLM_MAX_TOKENS=4096
# LLM_OUTPUT_LANGUAGE=ja
# LLM_REPORT_MAX_QUERIES_PER_SECTION=3
# LLM_REASONING_RESERVE_TOKENS=0
# FORENSIA_PROMPT_BUDGET_TOKENS=12000

# Advanced budget overrides. By default these derive from the total prompt budget.
# FORENSIA_SYSTEM_PROMPT_BUDGET_CHARS=24000
# LLM_MEMORY_MAX_BYTES=16000
# STRUCTURED_MARKDOWN_MAX_ROWS=200
# LLM_OUTAGE_WALL_CLOCK_BUDGET_S=28800
# LLM_OUTAGE_PROBE_INTERVAL_S=60

# Web UI development only.
# FORENSIA_API_BASE_URL="http://127.0.0.1:8000"
# FORENSIA_UI_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
